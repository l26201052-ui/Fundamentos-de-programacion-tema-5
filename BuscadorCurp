package Tema5;
import java.util.Scanner;
public class BuscadorCURP {
    public static void main(String[] args){
        Scanner scanner = new Scanner(System.in);

        System.out.println("   BUSCADOR DE CURP   ");
        System.out.print("Nombre(s): ");
        String nombre = limpiarTexto(scanner.nextLine());
        System.out.print("Apellido paterno: ");
        String paterno = limpiarTexto(scanner.nextLine());
        System.out.print("Apellido materno: ");
        String materno = limpiarTexto(scanner.nextLine());
        System.out.print("Fecha de nacimiento (dd/mm/aaaa): ");
        String fecha = scanner.nextLine();
        System.out.print("Sexo (H o M): ");
        String sexo = scanner.nextLine().toUpperCase();
        System.out.print("Entidad federativa de nacimiento: ");
        String entidad = limpiarTexto(scanner.nextLine());
        String curp = generarCURP(nombre, paterno, materno, fecha, sexo, entidad);
        System.out.println("\nTu CURP generada es: " + curp);
    }
    public static String limpiarTexto(String texto) {
        texto = texto.trim().toUpperCase();
        texto = texto.replace("Á", "A");
        texto = texto.replace("É", "E");
        texto = texto.replace("Í", "I");
        texto = texto.replace("Ó", "O");
        texto = texto.replace("Ú", "U");
        return texto;
    }
    public static char obtenerPrimeraLetra(String palabra) {
        return palabra.charAt(0);
    }
    public static char obtenerPrimeraVocal(String palabra) {
        String interna = palabra.substring(1);
        int a = (interna + "A").indexOf("A");
        int e = (interna + "E").indexOf("E");
        int i = (interna + "I").indexOf("I");
        int o = (interna + "O").indexOf("O");
        int u = (interna + "U").indexOf("U");

        int primera = Math.min(Math.min(a, e), Math.min(Math.min(i, o), u));
        return (interna + "X").charAt(primera);
    }
    public static char obtenerPrimeraConsonante(String palabra) {
        String interna = palabra.substring(1);
        String sinVocales = interna.replace("A", "").replace("E", "").replace("I", "").replace("O", "").replace("U", "");
        return (sinVocales + "X").charAt(0);
    }
    public static String obtenerFecha(String fecha) {
        String dia = fecha.substring(0, 2);
        String mes = fecha.substring(3, 5);
        String anioCorto = fecha.substring(8, 10);
        return anioCorto + mes + dia;
    }
    public static String obtenerClaveEstado(String entidad) {
        String tabla = ";AGUASCALIENTES:AS;BAJA CALIFORNIA:BC;BAJA CALIFORNIA SUR:BS" + ";CAMPECHE:CC;COAHUILA:CL;COLIMA:CM;CHIAPAS:CS;CHIHUAHUA:CH" + ";CIUDAD DE MEXICO:DF;DURANGO:DG;GUANAJUATO:GT;GUERRERO:GR" + ";HIDALGO:HG;JALISCO:JC;MEXICO:MC;MICHOACAN:MN;MORELOS:MS" + ";NAYARIT:NT;NUEVO LEON:NL;OAXACA:OC;PUEBLA:PL;QUERETARO:QT" + ";QUINTANA ROO:QR;SAN LUIS POTOSI:SL;SINALOA:SR;SONORA:SN" + ";TABASCO:TB;TAMAULIPAS:TS;TLAXCALA:TL;VERACRUZ:VZ" + ";YUCATAN:YN;ZACATECAS:ZS";
        int posicion = tabla.indexOf(";" + entidad + ":") + entidad.length() + 2;
        return tabla.substring(posicion, posicion + 2);
    }
    public static String generarCURP(String nombre, String paterno, String materno, String fecha, String sexo, String entidad) {
        int posEspacio = (nombre + " ").indexOf(" ");
        String primerNombre = nombre.substring(0, posEspacio);
        int dig1 = (int)(Math.random() * 10);
        String curp = "" + obtenerPrimeraLetra(paterno) + obtenerPrimeraVocal(paterno) + obtenerPrimeraLetra(materno) + obtenerPrimeraLetra(primerNombre) + obtenerFecha(fecha) + sexo + obtenerClaveEstado(entidad) + obtenerPrimeraConsonante(paterno) + obtenerPrimeraConsonante(materno) + obtenerPrimeraConsonante(primerNombre) + dig1;
        return curp;
    }
}
